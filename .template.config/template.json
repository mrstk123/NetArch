{
    "$schema": "http://json.schemastore.org/template",
    "author": "Si Thu Kyaw",
    "classifications": [
        "Web",
        "API",
        "Architecture"
    ],
    "name": "NetArch Architecture Template",
    "identity": "NetArch.Template.CSharp",
    "shortName": "net-arch",
    "tags": {
        "language": "C#",
        "type": "project"
    },
    "sourceName": "NetArch.Template",
    "preferNameDirectory": true,
    "symbols": {
        "architecture": {
            "type": "parameter",
            "dataType": "choice",
            "defaultValue": "Clean",
            "choices": [
                {
                    "choice": "Clean",
                    "description": "Domain, Application, and Infrastructure layers"
                },
                {
                    "choice": "NTier",
                    "description": "BusinessLogic and DataAccess layers"
                }
            ]
        },
        "ui": {
            "type": "parameter",
            "dataType": "choice",
            "defaultValue": "None",
            "choices": [
                {
                    "choice": "None",
                    "description": "Back-end API only"
                },
                {
                    "choice": "Angular",
                    "description": "ASP.NET Core with Angular SPA"
                }
            ]
        },
        "orm": {
            "type": "parameter",
            "dataType": "choice",
            "defaultValue": "EFCore",
            "choices": [
                {
                    "choice": "EFCore",
                    "description": "Entity Framework Core"
                },
                {
                    "choice": "Dapper",
                    "description": "Dapper Micro-ORM"
                },
                {
                    "choice": "Hybrid",
                    "description": "EF Core for Writes, Dapper for Reads"
                }
            ]
        },
        "IsClean": {
            "type": "computed",
            "value": "(architecture == \"Clean\" || architecture == \"clean\")"
        },
        "IsNTier": {
            "type": "computed",
            "value": "(architecture == \"NTier\" || architecture == \"ntier\")"
        },
        "IsEFCore": {
            "type": "computed",
            "value": "(orm == \"EFCore\" || orm == \"efcore\")"
        },
        "IsDapper": {
            "type": "computed",
            "value": "(orm == \"Dapper\" || orm == \"dapper\")"
        },
        "IsHybrid": {
            "type": "computed",
            "value": "(orm == \"Hybrid\" || orm == \"hybrid\")"
        },
        "IsAngular": {
            "type": "computed",
            "value": "(ui == \"Angular\" || ui == \"angular\")"
        }
    },
    "sources": [
        {
            "exclude": [
                ".git/**",
                "**/.idea/**",
                ".vscode/*",
                ".template.config/**",
                ".github/workflows/auto-release.yml",
                "TestNetArch/**",
                "README.md",
                "NetArch.Template.csproj",
                "**/bin/**",
                "**/obj/**",
                "**/node_modules/**",
                "**/.angular/**"
            ],
            "modifiers": [
                {
                    "condition": "(ui != 'Angular' && ui != 'angular')",
                    "exclude": [
                        "NetArch.Template.ClientApp/**"
                    ]
                },
                {
                    "condition": "(architecture == 'NTier' || architecture == 'ntier')",
                    "exclude": [
                        "NetArch.Template.Domain/**",
                        "NetArch.Template.Application/**"
                    ]
                },
                {
                    "condition": "(architecture == 'Clean' || architecture == 'clean')",
                    "exclude": [
                        "NetArch.Template.BusinessLogic/**"
                    ]
                },
                {
                    "condition": "(orm != 'EFCore' && orm != 'efcore')",
                    "exclude": [
                        "NetArch.Template.Domain/Interfaces/IGenericRepository.cs",
                        "NetArch.Template.Domain/Interfaces/IUnitOfWork.cs",
                        "NetArch.Template.BusinessLogic/Interfaces/IGenericRepository.cs",
                        "NetArch.Template.BusinessLogic/Interfaces/IUnitOfWork.cs",
                        "NetArch.Template.Infrastructure/Persistence/Repositories/**"
                    ]
                },
                {
                    "condition": "(orm == 'Dapper' || orm == 'dapper')",
                    "exclude": [
                        "NetArch.Template.Infrastructure/Persistence/Interceptors/**",
                        "NetArch.Template.Infrastructure/Persistence/Configurations/*.cs",
                        "NetArch.Template.Infrastructure/Persistence/Context/*.cs",
                        "NetArch.Template.Infrastructure/Services/*.cs"
                    ]
                },
                {
                    "condition": "(orm == 'EFCore' || orm == 'efcore')",
                    "exclude": [
                        "NetArch.Template.Application/Interfaces/Commands/*.cs",
                        "NetArch.Template.Application/Interfaces/Queries/*.cs",
                        "NetArch.Template.Application/DTOs/CreateProductRequest.cs",
                        "NetArch.Template.Application/DTOs/ProductSummaryDto.cs",
                        "NetArch.Template.BusinessLogic/Interfaces/Commands/*.cs",
                        "NetArch.Template.BusinessLogic/Interfaces/Queries/*.cs",
                        "NetArch.Template.BusinessLogic/DTOs/*.cs",
                        "NetArch.Template.Infrastructure/Commands/*.cs",
                        "NetArch.Template.Infrastructure/Queries/*.cs",
                        "NetArch.Template.Infrastructure/Persistence/Scripts/001_CreateProducts.sql",
                        "NetArch.Template.WebAPI/Controllers/ProductsController.cs"
                    ]
                }
            ]
        }
    ]
}